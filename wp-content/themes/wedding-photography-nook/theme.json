	"styles": {
		"blocks": {
			"core/button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--questrial)",
					"fontSize": "var(--wp--preset--font-size--custom-1)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				},
				"variations": {
					"outline": {
						"border": {
							"width": "1px"
						},
						"spacing": {
							"padding": {
								"bottom": "15px",
								"left": "23px",
								"right": "23px",
								"top": "15px"
							}
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "8px",
					"margin": {
						"top": "calc( var(--wp--style--block-gap) * 1.5)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--red-hat-text)"
				}
			},
			"core/column": {
				"variations": {
					"section-1": {
