  "styles": {
    "color": {
      "background": "var(--wp--preset--color--theme-1)",
      "text": "var(--wp--preset--color--theme-2)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--commissioner)",
      "fontWeight": "300",
      "lineHeight": "1.7"
    },
    "css": "/* ---- Κόκκινες λεπτομέρειες ---- */\n.no-underline a{text-decoration:none;}\na{text-decoration-color:var(--wp--preset--color--accent);text-decoration-thickness:2px;text-underline-offset:0.25em;transition:color .2s ease,text-decoration-color .2s ease;}\n::selection{background:var(--wp--preset--color--accent);color:#fff;}\n:where(a,button,input,select,textarea,summary,.wp-element-button):focus-visible{outline:2px solid var(--wp--preset--color--accent);outline-offset:3px;}\n\n/* Μενού: κόκκινη γραμμή που «μεγαλώνει» στο hover, μόνιμη στην ενεργή σελίδα */\n.wp-block-navigation .wp-block-navigation-item__content{position:relative;}\n.wp-block-navigation .wp-block-navigation-item__content::after{content:\"\";position:absolute;left:0;right:0;bottom:-0.35em;height:2px;background:var(--wp--preset--color--accent);transform:scaleX(0);transform-origin:left;transition:transform .3s ease;}\n.wp-block-navigation .wp-block-navigation-item__content:hover::after,\n.wp-block-navigation .current-menu-item>.wp-block-navigation-item__content::after,\n.wp-block-navigation [aria-current=\"page\"]::after{transform:scaleX(1);}\n.wp-block-navigation .current-menu-item>a,.wp-block-navigation a[aria-current=\"page\"]{color:var(--wp--preset--color--accent);}\n\n/* Διαχωριστικά και λίστες σε κόκκινο */\n.wp-block-separator{border-color:var(--wp--preset--color--accent);color:var(--wp--preset--color--accent);}\nli::marker{color:var(--wp--preset--color--accent);}\nblockquote,.wp-block-quote{border-left-color:var(--wp--preset--color--accent);}\n\n@media (prefers-reduced-motion:reduce){a,.wp-block-navigation .wp-block-navigation-item__content::after{transition:none;}}",
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--roboto-condensed)",
          "textTransform": "uppercase",
          "fontWeight": "700",
          "letterSpacing": "0.01em",
          "lineHeight": "1.05"
        }
      },
      "h1": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "0.95"
        }
      },
      "h2": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1"
        }
      },
      "h3": {
        "typography": {
          "fontWeight": "600",
          "letterSpacing": "0.03em"
        }
      },
      "h4": {
        "typography": {
          "fontWeight": "500",
          "letterSpacing": "0.05em"
        }
      },
      "h5": {
        "typography": {
          "fontWeight": "500",
          "letterSpacing": "0.08em"
        }
      },
      "h6": {
        "typography": {
          "fontWeight": "500",
          "letterSpacing": "0.1em"
        }
      },
      "link": {
        "color": {
          "text": "currentColor"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent)"
          }
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--roboto-condensed)",
          "textTransform": "uppercase",
          "fontWeight": "600",
          "letterSpacing": "0.1em"
        },
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "#FFFFFF"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent-dark)",
            "text": "#FFFFFF"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--roboto-condensed)",
          "textTransform": "uppercase",
          "fontWeight": "500",
          "letterSpacing": "0.12em"
        },
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--accent)"
              }
            }
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--roboto-condensed)",
          "textTransform": "uppercase",
          "fontWeight": "600",
          "letterSpacing": "0.14em"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        }
      }
    }
  }
}